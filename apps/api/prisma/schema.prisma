generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Material {
  id String @id @default(cuid())
  name String
  type String
  color String
  unit String
  currentQuantity Decimal @db.Decimal(12, 2)
  lowStockThreshold Decimal? @db.Decimal(12, 2)
  movements InventoryMovement[]
  allocations MaterialAllocation[]
  createdAt DateTime @default(now())
}
model Project {
  id String @id @default(cuid())
  name String
  type String
  primaryColor String
  status ProjectStatus @default(WISHLIST)
  description String?
  reference String?
  completedAt DateTime?
  allocations MaterialAllocation[]
  finishedGood FinishedGood?
  createdAt DateTime @default(now())
}
model MaterialAllocation {
  id String @id @default(cuid())
  projectId String
  materialId String
  quantity Decimal @db.Decimal(12, 2)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}
model FinishedGood {
  id String @id @default(cuid())
  sourceProjectId String @unique
  name String
  type String
  primaryColor String
  completedAt DateTime
  sourceProject Project @relation(fields: [sourceProjectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
enum ProjectStatus {
  WISHLIST
  IN_PROGRESS
  COMPLETED
}
model InventoryMovement {
  id String @id @default(cuid())
  materialId String
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantityDelta Decimal @db.Decimal(12, 2)
  reason MovementReason
  projectId String?
  allocationId String?
  occurredAt DateTime @default(now())
}
enum MovementReason {
  OPENING_BALANCE
  ADJUSTMENT
  PURCHASE
  ALLOCATION
  RETURN
}
